# Copy this file to .env and replace values before final clean tests.

# Shared infrastructure
SQLSERVER_SA_PASSWORD=ChangeMe123!
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_DEFAULT_PASS
RABBITMQ_USERNAME=CHANGE_ME_RABBITMQ_USERNAME
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# Auth/Catalog JWT
JWT_KEY=CHANGE_ME_WITH_LONG_SECURE_JWT_KEY
JWT_ISSUER=FiapGamesApi
JWT_AUDIENCE=FiapGamesClients

# Service connection strings
AUTH_CONNECTION_STRING=Server=sqlserver-auth,1433;Database=fiapgames_auth;User Id=sa;Password=ChangeMe123!;TrustServerCertificate=True
PAYMENT_CONNECTION_STRING=Server=sqlserver-payment,1433;Database=fiapgames_payment;User Id=sa;Password=ChangeMe123!;TrustServerCertificate=True;Encrypt=False;Connect Timeout=60;ConnectRetryCount=20;ConnectRetryInterval=5
CATALOG_CONNECTION_STRING=Server=sqlserver-catalog,1433;Database=fiapgames_catalog;User Id=sa;Password=ChangeMe123!;TrustServerCertificate=True;Encrypt=False;Connect Timeout=60;ConnectRetryCount=20;ConnectRetryInterval=5
NOTIFICATION_CONNECTION_STRING=Server=sqlserver-notification,1433;Database=fiapgames_notifications;User Id=sa;Password=ChangeMe123!;TrustServerCertificate=True;Encrypt=False;Connect Timeout=60;ConnectRetryCount=20;ConnectRetryInterval=5
