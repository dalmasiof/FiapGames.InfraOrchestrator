# Copy this file to .env and replace values before final clean tests.

# Shared infrastructure
SQLSERVER_SA_PASSWORD=CHANGE_ME_SQLSERVER_SA_PASSWORD
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_DEFAULT_PASS
RABBITMQ_USERNAME=CHANGE_ME_RABBITMQ_USERNAME
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# Auth/Catalog JWT
JWT_ISSUER=FiapGamesApi
JWT_AUDIENCE=FiapGamesClients

# Service connection strings
AUTH_CONNECTION_STRING=Server=sqlserver,1433;Database=fiapgames_auth;User Id=sa;Password=CHANGE_ME_SQLSERVER_SA_PASSWORD;TrustServerCertificate=True
PAYMENT_CONNECTION_STRING=Server=sqlserver,1433;Database=fiapgames_payment;User Id=sa;Password=CHANGE_ME_SQLSERVER_SA_PASSWORD;TrustServerCertificate=True;Encrypt=False;Connect Timeout=60;ConnectRetryCount=20;ConnectRetryInterval=5
CATALOG_CONNECTION_STRING=Server=sqlserver,1433;Database=fiapgames_catalog;User Id=sa;Password=CHANGE_ME_SQLSERVER_SA_PASSWORD;TrustServerCertificate=True;Encrypt=False;Connect Timeout=60;ConnectRetryCount=20;ConnectRetryInterval=5
