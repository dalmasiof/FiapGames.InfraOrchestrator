      "name": "Auth",
      "item": [
        {
          "name": "01 - Solicitar Token",
          "description": "POST {{Url_Auth}}/Auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"{{admin_email}}\",\n  \"PasswordHash\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url_Auth}}/Auth/login",
              "host": [
                "{{Url_Auth}}"
              ],
              "path": [
                "Auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login retornou sucesso', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let payload = {};",
                  "try {",
                  "  payload = pm.response.json();",
                  "} catch (error) {",
                  "  payload = {};",
                  "}",
                  "",
                  "const token = payload.token || payload.Token || payload.accessToken || payload.jwt || (payload.data && (payload.data.token || payload.data.Token || payload.data.accessToken || payload.data.jwt));",
                  "if (token) {",
                  "  pm.environment.set('token', token);",
                  "  pm.collectionVariables.set('token', token);",
                  "}",
                  "",
                  "pm.test('Token foi retornado', function () {",
                  "  pm.expect(token, 'token ausente na resposta').to.be.ok;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
